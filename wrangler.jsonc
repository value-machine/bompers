{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Unique Worker name for this fork (must equal the Worker name in Workers Builds).
  "name": "bompers",
  "compatibility_date": "2026-06-23",
  "workers_dev": true,
  "preview_urls": true,
  // Assets-only SPA Worker (no `main`, no ASSETS binding).
  // Account is NOT pinned here so the template stays fork-safe — set
  // CLOUDFLARE_ACCOUNT_ID in Workers Builds (and locally) instead.
  // Custom domains are a per-fork opt-in: add a `routes` entry in your fork.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
