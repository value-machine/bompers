{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "matcher": "git",
        "command": "node scripts/deny-git-write-on-main.cjs",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write",
        "command": "node scripts/lint-edited-file.cjs",
        "timeout": 60,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "node scripts/type-check-on-stop.cjs",
        "timeout": 120,
        "loop_limit": 3,
        "failClosed": false
      }
    ]
  }
}
